MOSAIC_BCM_EXECUTION_MODE=local
MOSAIC_BCM_ADAPTER_HOST=192.0.2.10
MOSAIC_BCM_ADAPTER_PORT=3002
MOSAIC_BCM_PUBLIC_URL=https://bcm-head.example.com:3002
MOSAIC_BCM_TLS_CERT=/etc/bcm-mcp/server.crt
MOSAIC_BCM_TLS_KEY=/etc/bcm-mcp/server.key
MOSAIC_BCM_MCP_TOKEN=replace-with-server-token
MOSAIC_BCM_CMSH_ENABLED=true
MOSAIC_BCM_CMSH_ADMIN_ENABLED=false
MCP_NOTES_DIR=/var/lib/bcm-mcp/notes
# Enable these only when their matching AFOA modules are enabled.
MOSAIC_BCM_REDFISH_ENABLED=false
MOSAIC_BCM_HARDWARE_COMPAT_ENABLED=false
# MOSAIC_BCM_HARDWARE_TOKEN=replace-with-hardware-agent-webhook-token
