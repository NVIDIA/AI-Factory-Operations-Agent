{{- $managedMcpServers := dict -}}
{{- range $name, $config := .Values.managedMcpServers.servers -}}
{{- if $config.enabled -}}
{{- $server := mergeOverwrite (deepCopy $.Values.managedMcpServers.defaults) $config -}}
{{- $mcp := deepCopy $server.mcp -}}
{{- $headers := deepCopy $mcp.headers -}}
{{- range $headerName, $secret := $mcp.secretHeaders -}}
{{- $envName := printf "MOSAIC_MCP_%s" (upper (trunc 16 (sha256sum (printf "%s:%s" $name $headerName)))) -}}
{{- $_ := set $headers $headerName (printf "%s${%s}" (default "" $secret.prefix) $envName) -}}
{{- end -}}
{{- $_ := unset $mcp "secretHeaders" -}}
{{- if $headers -}}
{{- $_ := set $mcp "headers" $headers -}}
{{- else -}}
{{- $_ := unset $mcp "headers" -}}
{{- end -}}
{{- $_ := set $mcp "url" (printf "http://mcp-%s:%v%s" $name $server.port $server.path) -}}
{{- $_ := set $mcp "transport" $server.transport -}}
{{- $_ := set $managedMcpServers $name $mcp -}}
{{- end -}}
{{- end -}}
{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "*"
      ],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "llm/{{ include "mosaic-stack.llmModel" . }}"
      },
      "skills": [
        "bcm",
        "hardware-agent",
        "iraop",
        "observability",
        "slurm"
      ],
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      {{- if .Values.openclaw.slack.enabled }}
      "maxConcurrent": {{ .Values.openclaw.slack.maxConcurrent }},
      {{- end }}
      "sandbox": {
        "mode": "all",
        "backend": "openshell",
        "scope": "session",
        "workspaceAccess": "ro"
      }
    },
    "list": [
      {
        "id": "default",
        "name": "OpenClaw Assistant",
        "workspace": "~/.openclaw/workspace",
        "thinkingDefault": "off",
        "reasoningDefault": "off"
      }
    ]
  },
  {{- if .Values.openclaw.slack.enabled }}
  "session": {
    "dmScope": {{ .Values.openclaw.slack.session.dmScope | quote }}
  },
  "diagnostics": {
    "enabled": true,
    "stuckSessionWarnMs": {{ .Values.openclaw.slack.diagnostics.stuckSessionWarnMs }},
    "stuckSessionAbortMs": {{ .Values.openclaw.slack.diagnostics.stuckSessionAbortMs }}
  },
  "messages": {
    "queue": {
      "byChannel": {
        "slack": {{ .Values.openclaw.slack.queueMode | quote }}
      }
    }
  },
  {{- end }}
  "tools": {
    "alsoAllow": [
      "group:plugins"
    ],
    "sandbox": {
      "tools": {
        "alsoAllow": [
          "group:plugins"
        ]
      }
    }
  },
  {{- if $managedMcpServers }}
  "mcp": {
    "servers": {{ $managedMcpServers | toJson }}
  },
  {{- end }}
  {{- if .Values.openclaw.slack.enabled }}
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "botToken": "${SLACK_BOT_TOKEN}",
      "appToken": "${SLACK_APP_TOKEN}",
      "configWrites": false,
      "allowBots": false,
      "dmPolicy": "allowlist",
      "allowFrom": {{ .Values.openclaw.slack.allowedUserIds | toJson }},
      {{- if gt (len .Values.openclaw.slack.editUserIds) 0 }}
      "execApprovals": {
        "enabled": true,
        "approvers": {{ .Values.openclaw.slack.editUserIds | toJson }},
        "target": "dm"
      },
      {{- end }}
      "dm": {
        "groupEnabled": {{ .Values.openclaw.slack.groupDmsEnabled }}
      },
      "replyToModeByChatType": {{ .Values.openclaw.slack.replyToModeByChatType | toJson }},
      "streaming": {{ .Values.openclaw.slack.streaming | toJson }},
      "groupPolicy": {{ ternary "allowlist" "disabled" .Values.openclaw.slack.channelMentionsEnabled | quote }},
      {{- if .Values.openclaw.slack.channelMentionsEnabled }}
      "channels": {
        "*": {
          "enabled": true,
          "requireMention": true,
          "users": {{ .Values.openclaw.slack.allowedUserIds | toJson }}
        }
      },
      {{- end }}
      "unfurlLinks": false,
      "unfurlMedia": false
    }
  },
  {{- end }}
  "models": {
    "providers": {
      "llm": {
        "baseUrl": "${OPENCLAW_VLLM_BASE_URL}",
        "apiKey": "${VLLM_API_KEY}",
        "api": "openai-completions",
        "request": {
          "allowPrivateNetwork": true
        },
        "models": [
          {
            "id": {{ include "mosaic-stack.llmModel" . | quote }},
            "name": "Nemotron Ultra 550B A55B (NVFP4)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "plugins": {
    "allow": [
      "automation-guard",
      "bcm",
      "hardware-agent",
      "grafana",
      "iraop",
      "kubernetes",
      "openshell",
      "observability",
      "remote-ssh",
      "slurm",
      "llm"{{- if .Values.openclaw.slack.enabled }},
      "slack"{{- end }}
    ],
    "entries": {
      "automation-guard": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "editEnabled": {{ .Values.modules.edit.enabled }},
          "hitl": {{ .Values.modules.edit.hitl }},
          "approvalTimeoutMs": {{ .Values.modules.edit.approvalTimeoutMs }},
          "mcpToolPolicies": {
            {{- $firstPolicy := true -}}
            {{- range $name, $config := .Values.managedMcpServers.servers -}}
            {{- if $config.enabled -}}
            {{- $server := mergeOverwrite (deepCopy $.Values.managedMcpServers.defaults) $config -}}
            {{- if not $firstPolicy }},{{ end }}
            {{ $name | quote }}: {{ $server.toolPolicy | toJson }}
            {{- $firstPolicy = false -}}
            {{- end -}}
            {{- end }}
          },
          "slackEnabled": {{ .Values.openclaw.slack.enabled }},
          "slackEditUserIds": {{ .Values.openclaw.slack.editUserIds | toJson }}
        }
      },
      "llm": {
        "enabled": true
      }{{- if .Values.openclaw.slack.enabled }},
      "slack": {
        "enabled": true
      }{{- end }},
      "kubernetes": {
        "enabled": {{ .Values.modules.kubernetes.enabled }},
        "config": {
          "command": {{ .Values.kubernetes.command | quote }},
          "defaultCluster": {{ .Values.kubernetes.defaultCluster | quote }},
          "clusters": {{ include "mosaic-stack.kubernetesClusters" . }},
          "editEnabled": {{ and .Values.modules.edit.enabled .Values.modules.edit.kubernetes.enabled }},
          "hitl": {{ .Values.modules.edit.hitl }},
          "approvalTimeoutMs": {{ .Values.modules.edit.approvalTimeoutMs }},
          "maxOutputBytes": {{ .Values.kubernetes.maxOutputBytes }},
          "timeoutMs": {{ .Values.kubernetes.timeoutMs }}
        }
      },
      "openshell": {
        "enabled": true,
        "config": {
          "from": {{ .Values.openshell.server.sandboxImage | quote }},
          "mode": "remote",
          "command": {{ .Values.openclaw.openshell.command | quote }},
          "gateway": {{ include "mosaic-stack.openshellGatewayName" . | quote }},
          "gatewayEndpoint": {{ include "mosaic-stack.openshellGatewayEndpoint" . | quote }}{{- if .Values.openclaw.openshell.policy }},
          "policy": {{ .Values.openclaw.openshell.policy | quote }}{{- end }},
          "remoteWorkspaceDir": "/sandbox",
          "remoteAgentWorkspaceDir": "/sandbox/mosaic-agent-workspace"
        }
      },
      "hardware-agent": {
        "enabled": {{ and .Values.modules.diagnostics.enabled .Values.diagnosticAgent.enabled }}
      },
      "iraop": {
        "enabled": {{ .Values.modules.research.enabled }},
        "config": {
          "baseUrl": {{ printf "http://iraop:%v/mcp/sse" .Values.researchAgent.iraop.service.port | quote }},
          {{- if .Values.modules.research.enabled }}
          "apiKey": "${IRAOP_API_KEY}",
          {{- end }}
          "timeoutMs": {{ default 240000 .Values.modules.research.timeoutMs }}
        }
      },
      "bcm": {
        "enabled": {{ eq (include "mosaic-stack.bcmEnabled" .) "true" }},
        "config": {
          "mcpUrl": {{ .Values.bcmMcp.mcpUrl | quote }},
          "headHost": {{ .Values.bcmMcp.headHost | quote }},
          "mcpMode": {{ .Values.bcmMcp.mode | quote }},
          {{- if and .Values.bcmMcp.enabled (eq .Values.bcmMcp.mode "ssh-adapter") }}
          "authToken": "${MOSAIC_BCM_MCP_TOKEN}",
          {{- end }}
          "cmshEnabled": {{ not .Values.bcmMcp.config.noCmshUser }},
          "editEnabled": {{ and .Values.modules.edit.enabled .Values.modules.edit.bcm.enabled (eq (include "mosaic-stack.bcmEnabled" .) "true") }},
          "hitl": {{ .Values.modules.edit.hitl }},
          "approvalTimeoutMs": {{ .Values.modules.edit.approvalTimeoutMs }},
          "slurmEnabled": {{ eq (include "mosaic-stack.slurmBcmEnabled" .) "true" }}
        }
      },
      "remote-ssh": {
        "enabled": {{ and .Values.modules.edit.enabled .Values.modules.edit.ssh.enabled }},
        "config": {
          "command": "/tools/ssh",
          "keyPath": "/var/run/mosaic-ssh/id",
          "knownHostsPath": "/var/run/mosaic-ssh/known_hosts",
          "hosts": {{ toJson .Values.modules.edit.ssh.hosts }},
          "hitl": {{ .Values.modules.edit.hitl }},
          "approvalTimeoutMs": {{ .Values.modules.edit.approvalTimeoutMs }},
          "timeoutMs": {{ .Values.modules.edit.ssh.timeoutMs }},
          "maxOutputBytes": {{ .Values.modules.edit.ssh.maxOutputBytes }}
        }
      },
      "grafana": {
        "enabled": {{ and .Values.modules.observability.enabled .Values.modules.grafana.enabled }},
        "config": {
          "grafanaUrl": {{ .Values.observability.grafanaUrl | quote }},
          "prometheusUrl": {{ .Values.observability.prometheusUrl | quote }},
          "datasourceUid": {{ .Values.observability.grafanaDatasourceUid | quote }}
        }
      },
      "observability": {
        "enabled": {{ .Values.modules.observability.enabled }},
        "config": {
          "grafanaEnabled": {{ .Values.modules.grafana.enabled }},
          "grafanaUrl": {{ .Values.observability.grafanaUrl | quote }},
          "prometheusUrl": {{ .Values.observability.prometheusUrl | quote }},
          "datasourceUid": {{ .Values.observability.grafanaDatasourceUid | quote }}{{- if .Values.observability.grafanaAuth.existingSecret }},
          "basicUser": "${MOSAIC_GRAFANA_BASIC_USER}",
          "basicPassword": "${MOSAIC_GRAFANA_BASIC_PASSWORD}"{{- end }}
        }
      },
      "slurm": {
        "enabled": {{ eq (include "mosaic-stack.slurmEvidenceEnabled" .) "true" }},
        "config": {
          "evidenceUrl": "http://slurm-evidence-collector:{{ default 8080 .Values.slurmEvidenceCollector.port }}"
        }
      }
    }
  }
}
