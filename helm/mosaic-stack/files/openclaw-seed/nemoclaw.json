{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "*"
      ],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "llm/{{ include "mosaic-stack.llmModel" . }}"
      },
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      {{- if .Values.openclaw.slack.enabled }}
      "maxConcurrent": {{ .Values.openclaw.slack.maxConcurrent }},
      {{- end }}
      "sandbox": {
        "mode": "all",
        "backend": "openshell",
        "scope": "session",
        "workspaceAccess": "ro"
      }
    },
    "list": [
      {
        "id": "default",
        "name": "OpenClaw Assistant",
        "workspace": "~/.openclaw/workspace",
        "thinkingDefault": "off",
        "reasoningDefault": "off"
      }
    ]
  },
  {{- if .Values.openclaw.slack.enabled }}
  "session": {
    "dmScope": {{ .Values.openclaw.slack.session.dmScope | quote }}
  },
  "diagnostics": {
    "enabled": true,
    "stuckSessionWarnMs": {{ .Values.openclaw.slack.diagnostics.stuckSessionWarnMs }},
    "stuckSessionAbortMs": {{ .Values.openclaw.slack.diagnostics.stuckSessionAbortMs }}
  },
  "messages": {
    "queue": {
      "byChannel": {
        "slack": {{ .Values.openclaw.slack.queueMode | quote }}
      }
    }
  },
  {{- end }}
  "tools": {
    "alsoAllow": [
      "group:plugins"
    ],
    "sandbox": {
      "tools": {
        "alsoAllow": [
          "group:plugins"
        ]
      }
    }
  },
  {{- if .Values.openclaw.slack.enabled }}
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "botToken": "${SLACK_BOT_TOKEN}",
      "appToken": "${SLACK_APP_TOKEN}",
      "configWrites": false,
      "allowBots": false,
      "dmPolicy": "allowlist",
      "allowFrom": {{ .Values.openclaw.slack.allowedUserIds | toJson }},
      "dm": {
        "groupEnabled": {{ .Values.openclaw.slack.groupDmsEnabled }}
      },
      "replyToModeByChatType": {{ .Values.openclaw.slack.replyToModeByChatType | toJson }},
      "streaming": {{ .Values.openclaw.slack.streaming | toJson }},
      "groupPolicy": {{ ternary "allowlist" "disabled" .Values.openclaw.slack.channelMentionsEnabled | quote }},
      {{- if .Values.openclaw.slack.channelMentionsEnabled }}
      "channels": {
        "*": {
          "enabled": true,
          "requireMention": true,
          "users": {{ .Values.openclaw.slack.allowedUserIds | toJson }}
        }
      },
      {{- end }}
      "unfurlLinks": false,
      "unfurlMedia": false
    }
  },
  {{- end }}
  "models": {
    "providers": {
      "llm": {
        "baseUrl": "${OPENCLAW_VLLM_BASE_URL}",
        "apiKey": "${VLLM_API_KEY}",
        "api": "openai-completions",
        "request": {
          "allowPrivateNetwork": true
        },
        "models": [
          {
            "id": {{ include "mosaic-stack.llmModel" . | quote }},
            "name": "Nemotron Ultra 550B A55B (NVFP4)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "skills": {
    "allowBundled": []
  },
  "plugins": {
    "allow": [
      "bcm",
      "diagnostic-agent",
      "grafana",
      "iraop",
      "kubernetes",
      "openshell",
      "observability",
      "slurm",
      "llm"{{- if .Values.openclaw.slack.enabled }},
      "slack"{{- end }}
    ],
    "entries": {
      "llm": {
        "enabled": true
      }{{- if .Values.openclaw.slack.enabled }},
      "slack": {
        "enabled": true
      }{{- end }},
      "kubernetes": {
        "enabled": {{ .Values.modules.kubernetes.enabled }},
        "config": {
          "command": {{ .Values.kubernetes.command | quote }},
          "defaultCluster": {{ .Values.kubernetes.defaultCluster | quote }},
          "clusters": {{ include "mosaic-stack.kubernetesClusters" . }},
          "maxOutputBytes": {{ .Values.kubernetes.maxOutputBytes }},
          "timeoutMs": {{ .Values.kubernetes.timeoutMs }}
        }
      },
      "openshell": {
        "enabled": true,
        "config": {
          "from": {{ .Values.openshell.server.sandboxImage | quote }},
          "mode": "remote",
          "command": {{ .Values.openclaw.openshell.command | quote }},
          "gateway": {{ include "mosaic-stack.openshellGatewayName" . | quote }},
          "gatewayEndpoint": {{ include "mosaic-stack.openshellGatewayEndpoint" . | quote }}{{- if .Values.openclaw.openshell.policy }},
          "policy": {{ .Values.openclaw.openshell.policy | quote }}{{- end }},
          "remoteWorkspaceDir": "/sandbox",
          "remoteAgentWorkspaceDir": "/sandbox/mosaic-agent-workspace"
        }
      },
      "diagnostic-agent": {
        "enabled": {{ and .Values.modules.diagnostics.enabled .Values.diagnosticAgent.enabled }}
      },
      "iraop": {
        "enabled": {{ .Values.modules.research.enabled }},
        "config": {
          "baseUrl": {{ .Values.modules.research.baseUrl | quote }},
          "timeoutMs": {{ default 240000 .Values.modules.research.timeoutMs }}
        }
      },
      "bcm": {
        "enabled": {{ eq (include "mosaic-stack.bcmEnabled" .) "true" }},
        "config": {
          "mcpUrl": {{ .Values.bcmMcp.mcpUrl | quote }},
          "headHost": {{ .Values.bcmMcp.headHost | quote }},
          "mcpMode": {{ .Values.bcmMcp.mode | quote }},
          "cmshEnabled": {{ not .Values.bcmMcp.config.noCmshUser }},
          "slurmEnabled": {{ eq (include "mosaic-stack.slurmBcmEnabled" .) "true" }}
        }
      },
      "grafana": {
        "enabled": {{ and .Values.modules.observability.enabled .Values.modules.grafana.enabled }}
      },
      "observability": {
        "enabled": {{ .Values.modules.observability.enabled }},
        "config": {
          "grafanaEnabled": {{ .Values.modules.grafana.enabled }},
          "grafanaUrl": {{ .Values.observability.grafanaUrl | quote }},
          "prometheusUrl": {{ .Values.observability.prometheusUrl | quote }},
          "datasourceUid": {{ .Values.observability.grafanaDatasourceUid | quote }}{{- if .Values.observability.grafanaAuth.existingSecret }},
          "basicUser": "${MOSAIC_GRAFANA_BASIC_USER}",
          "basicPassword": "${MOSAIC_GRAFANA_BASIC_PASSWORD}"{{- end }}
        }
      },
      "slurm": {
        "enabled": {{ eq (include "mosaic-stack.slurmEvidenceEnabled" .) "true" }},
        "config": {
          "evidenceUrl": "http://slurm-evidence-collector:{{ default 8080 .Values.slurmEvidenceCollector.port }}"
        }
      }
    }
  }
}
