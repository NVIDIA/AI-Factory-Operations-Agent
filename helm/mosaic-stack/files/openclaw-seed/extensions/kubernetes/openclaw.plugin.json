{
  "id": "kubernetes",
  "contracts": {
    "tools": [
      "run_kubectl"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string"
      },
      "defaultCluster": {
        "type": "string"
      },
      "clusters": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "maxOutputBytes": {
        "type": "number"
      },
      "timeoutMs": {
        "type": "number"
      },
      "editEnabled": {
        "type": "boolean"
      },
      "hitl": {
        "type": "boolean"
      },
      "approvalTimeoutMs": {
        "type": "number"
      }
    }
  }
}
