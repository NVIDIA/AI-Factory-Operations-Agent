{
  "id": "kubernetes",
  "contracts": {
    "tools": [
      "run_kubectl"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "command": {
        "type": "string"
      },
      "defaultCluster": {
        "type": "string"
      },
      "clusters": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kubeconfig"
              ],
              "properties": {
                "kubeconfig": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "tlsServerName": {
                  "type": "string"
                }
              }
            }
          ]
        }
      },
      "maxOutputBytes": {
        "type": "number"
      },
      "timeoutMs": {
        "type": "number"
      },
      "editEnabled": {
        "type": "boolean"
      },
      "hitl": {
        "type": "boolean"
      },
      "approvalTimeoutMs": {
        "type": "number"
      }
    }
  }
}
