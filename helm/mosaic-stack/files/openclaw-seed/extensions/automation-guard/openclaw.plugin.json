{
  "id": "automation-guard",
  "contracts": {
    "trustedToolPolicies": ["session-access"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "editEnabled": {
        "type": "boolean"
      },
      "slackEnabled": {
        "type": "boolean"
      },
      "slackEditUserIds": {
        "type": "array",
        "items": { "type": "string" }
      },
      "hitl": {
        "type": "boolean"
      },
      "approvalTimeoutMs": {
        "type": "number",
        "minimum": 1000
      },
      "mcpToolPolicies": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultAccess", "viewTools"],
          "properties": {
            "defaultAccess": {
              "type": "string",
              "enum": ["view", "edit"]
            },
            "viewTools": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
