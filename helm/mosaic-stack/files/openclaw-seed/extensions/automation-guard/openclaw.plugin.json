{
  "id": "automation-guard",
  "contracts": {
    "tools": ["request_mcp_connection"],
    "trustedToolPolicies": ["session-access"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "editEnabled": {
        "type": "boolean"
      },
      "slackEnabled": {
        "type": "boolean"
      },
      "slackEditUserIds": {
        "type": "array",
        "items": { "type": "string" }
      },
      "mcpConnectionRequestUrl": {
        "type": "string"
      },
      "hitl": {
        "type": "boolean"
      },
      "approvalTimeoutMs": {
        "type": "number",
        "minimum": 1000
      }
    }
  }
}
