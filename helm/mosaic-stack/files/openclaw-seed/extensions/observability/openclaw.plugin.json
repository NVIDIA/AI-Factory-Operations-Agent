{
  "id": "observability",
  "contracts": {
    "tools": [
      "observability_metric_names",
      "observability_query",
      "observability_range_query",
      "dashboard_list",
      "dashboard_create",
      "dashboard_open",
      "observability_log_labels",
      "observability_logs"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prometheusUrl": {
        "type": "string",
        "description": "Prometheus service base URL used for dashboard validation."
      },
      "grafanaEnabled": {
        "type": "boolean",
        "description": "Whether Grafana dashboard tools should be registered."
      },
      "grafanaUrl": {
        "type": "string",
        "description": "Grafana service base URL."
      },
      "uiUrl": {
        "type": "string",
        "description": "UI service base URL used to switch the frontend Grafana tab."
      },
      "datasourceUid": {
        "type": "string",
        "description": "Grafana Prometheus datasource UID."
      },
      "token": {
        "type": "string",
        "description": "Optional Grafana API token."
      },
      "basicUser": {
        "type": "string",
        "description": "Optional Grafana basic auth user."
      },
      "basicPassword": {
        "type": "string",
        "description": "Optional Grafana basic auth password."
      },
      "enabledTools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional allowlist of observability tool names to register."
      },
      "disabledTools": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional list of observability tool names to suppress."
      },
      "lokiUrl": {
        "type": "string",
        "description": "Optional Loki base URL; empty disables log tools."
      },
      "lokiTenantId": {
        "type": "string",
        "description": "Optional operator-configured Loki tenant."
      }
    },
    "required": [
      "prometheusUrl"
    ]
  }
}
