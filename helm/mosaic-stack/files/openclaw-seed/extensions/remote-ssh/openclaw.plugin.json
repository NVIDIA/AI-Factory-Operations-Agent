{
  "id": "remote-ssh",
  "contracts": {
    "tools": [
      "run_remote_ssh"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "hosts"
    ],
    "properties": {
      "command": {
        "type": "string"
      },
      "keyPath": {
        "type": "string"
      },
      "knownHostsPath": {
        "type": "string"
      },
      "hosts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alias",
            "address",
            "user"
          ],
          "properties": {
            "alias": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "port": {
              "type": "number"
            }
          }
        }
      },
      "hitl": {
        "type": "boolean"
      },
      "approvalTimeoutMs": {
        "type": "number"
      },
      "timeoutMs": {
        "type": "number"
      },
      "maxOutputBytes": {
        "type": "number"
      }
    }
  }
}
