{
  "id": "dcgm",
  "contracts": {
    "tools": [
      "dcgm_health",
      "dcgm_current",
      "dcgm_top",
      "dcgm_metric_names",
      "dcgm_raw_metric"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "DCGM exporter base URL."
      },
      "enabledTools": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional allowlist of DCGM tool names to register."
      },
      "disabledTools": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Optional list of DCGM tool names to suppress."
      }
    }
  }
}
