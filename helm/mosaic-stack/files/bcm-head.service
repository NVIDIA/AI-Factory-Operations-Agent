[Unit]
Description=AFOA Base Command Manager MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/afoa-bcm
Environment=PYTHONPATH=/opt/afoa-bcm/vendor
Environment=HOME=/root
EnvironmentFile=/etc/afoa-bcm/server.env
ExecStart=/opt/afoa-bcm/venv/bin/python /opt/afoa-bcm/bcm-mcp-ssh-server.py
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
