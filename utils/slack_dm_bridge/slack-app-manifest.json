{
  "display_information": {
    "name": "MOSAIC Incident Assistant",
    "description": "Read-only operational investigations in private, allowlisted incident threads."
  },
  "features": {
    "app_home": {"home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false},
    "bot_user": {"display_name": "MOSAIC Incident Assistant", "always_online": false}
  },
  "oauth_config": {"scopes": {"bot": ["chat:write", "im:write", "im:history"]}},
  "settings": {
    "event_subscriptions": {"bot_events": ["message.im"]},
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
